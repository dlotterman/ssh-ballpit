[Unit]
Description=SSH command review gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ssh-ballpit
Group=ssh-ballpit
ExecStart=/usr/local/bin/ssh-ballpit serve --config /etc/ssh-ballpit/server.yaml
EnvironmentFile=-/etc/ssh-ballpit/providers.env
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/ssh-ballpit/state
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
